{
  "name": "pharmawatch-backend",
  "version": "1.0.0",
  "private": true,
  "main": "dist/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node api.js && tsx watch src/server.ts",
    "build": "node api.js && tsc -p tsconfig.json",
    "start": "node api.js && node dist/server.js",
    "seed": "tsx src/app/utilities/seed.ts",
    "fresh": "tsx src/app/utilities/fresh.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx tests/domain.test.ts && tsx tests/auth.test.ts && tsx tests/sale.test.ts && tsx tests/approval.test.ts && tsx tests/api.test.ts",
    "e2e:api": "tsx tests/e2e-server.ts"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.5",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.2",
    "@types/supertest": "^6.0.2",
    "mongodb-memory-server": "^11.3.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
